{
  "name": "codelex-xhs-minitool",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node ../scripts/export-xhs-data.mjs",
    "dev": "vite --port 5199",
    "typecheck": "tsc --noEmit",
    "build": "node ../scripts/export-xhs-data.mjs && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "smoke": "node scripts/smoke.mjs",
    "interact": "node scripts/interact.mjs",
    "verify": "npm run smoke && npm run interact && npm run audit",
    "audit": "node ../.skill/minitool-zip-builder/scripts/audit_artifact.mjs ./dist",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
